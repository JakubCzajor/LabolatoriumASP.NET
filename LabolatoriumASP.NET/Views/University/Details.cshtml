@model UniversityDetailsViewModel

@{
ViewBag.Title = $"{Model.UniversityName} Rankings";
Layout = "_Layout";
}

<div class="my-3">
    <a href="@Url.Action("Index", "University")" class="btn btn-outline-secondary">Back to University List</a>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>@Model.UniversityName</h2>
    <a class="btn btn-success" asp-controller="University" asp-action="CreateRankingNote" asp-route-universityId="@Model.UniversityId">
        <i class="bi bi-plus-circle"></i> Add New Ranking Note
    </a>
</div>

<form method="get" asp-action="Details">
    <input type="hidden" name="id" value="@Model.UniversityId" />

    <div class="row mb-3">
        <div class="col-md-5">
            <label for="rankingSystem" class="form-label">Select Ranking System:</label>
            <select name="rankingSystem" id="rankingSystem" class="form-select">
                <option value="">All</option>
                @foreach (var system in Model.RankingSystems)
                {
                if (system == Model.SelectedRankingSystem)
                {
                <option value="@system" selected="selected">@system</option>
                }
                else
                {
                <option value="@system">@system</option>
                }
                }
            </select>
        </div>
        
        <div class="col-md-5">
            <label for="year" class="form-label">Select Year:</label>
            <select name="year" id="year" class="form-select">
                <option value="">All</option>
                @foreach (var year in Model.Years)
                {
                if (year == Model.SelectedYear)
                {
                <option value="@year" selected="selected">@year</option>
                }
                else
                {
                <option value="@year">@year</option>
                }
                }
            </select>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Filter</button>
    <a href="@Url.Action("Details", new { id = Model.UniversityId })" class="btn btn-secondary">Clear</a>
</form>

@if (Model.FilteredRankings.Any())
{
<table class="table table-striped mt-4">
    <thead>
    <tr>
        <th scope="col">Ranking System</th>
        <th scope="col">Criteria</th>
        <th scope="col">Year</th>
        <th scope="col">Score</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var ranking in Model.FilteredRankings)
    {
    <tr>
        <td>@ranking.RankingCriteria?.RankingSystem?.SystemName</td>
        <td>@ranking.RankingCriteria?.CriteriaName</td>
        <td>@ranking.Year</td>
        <td>@ranking.Score</td>
    </tr>
    }
    </tbody>
</table>
}
else
{
<p class="mt-2">No rankings found for the selected criteria.</p>
}

<div class="d-flex justify-content-between align-items-center mt-3">
    <div aria-label="Page navigation">
        <ul class="pagination">
            <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Details"
                   asp-route-id="@Model.UniversityId"
                   asp-route-rankingSystem="@Model.SelectedRankingSystem"
                   asp-route-year="@Model.SelectedYear"
                   asp-route-page="@(ViewBag.CurrentPage - 1)">
                    <i class="bi bi-caret-left-fill"></i>
                </a>
            </li>

            @if (ViewBag.TotalPages > 1)
            {
            int startPage = Math.Max(1, ViewBag.CurrentPage - 2);
            int endPage = Math.Min(ViewBag.TotalPages, ViewBag.CurrentPage + 2);

            if (startPage > 1)
            {
            <li class="page-item">
                <a class="page-link" asp-action="Details"
                   asp-route-id="@Model.UniversityId"
                   asp-route-rankingSystem="@Model.SelectedRankingSystem"
                   asp-route-year="@Model.SelectedYear"
                   asp-route-page="1">
                    1
                </a>
            </li>
            @if (startPage > 2)
            {
            <li class="page-item disabled"><span class="page-link">...</span></li>
            }
            }

            for (int i = startPage; i <= endPage; i++)
            {
            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                <a class="page-link" asp-action="Details"
                   asp-route-id="@Model.UniversityId"
                   asp-route-rankingSystem="@Model.SelectedRankingSystem"
                   asp-route-year="@Model.SelectedYear"
                   asp-route-page="@i">
                    @i
                </a>
            </li>
            }

            if (endPage < ViewBag.TotalPages)
            {
            @if (endPage < ViewBag.TotalPages - 1)
            {
            <li class="page-item disabled"><span class="page-link">...</span></li>
            }
            <li class="page-item">
                <a class="page-link" asp-action="Details"
                   asp-route-id="@Model.UniversityId"
                   asp-route-rankingSystem="@Model.SelectedRankingSystem"
                   asp-route-year="@Model.SelectedYear"
                   asp-route-page="@(ViewBag.TotalPages)">
                    @ViewBag.TotalPages
                </a>
            </li>
            }
            }

            <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Details"
                   asp-route-id="@Model.UniversityId"
                   asp-route-rankingSystem="@Model.SelectedRankingSystem"
                   asp-route-year="@Model.SelectedYear"
                   asp-route-page="@(ViewBag.CurrentPage + 1)">
                    <i class="bi bi-caret-right-fill"></i>
                </a>
            </li>
        </ul>
    </div>

    <form method="get" class="d-flex align-items-center ms-3">
        <input type="hidden" name="rankingSystem" value="@Model.SelectedRankingSystem" />
        <input type="hidden" name="year" value="@Model.SelectedYear" />
        <input type="number" name="page" min="1" max="@ViewBag.TotalPages" class="form-control w-auto"
               placeholder="Page" value="@ViewBag.CurrentPage" />
        <button type="submit" class="btn btn-primary ms-2">Go</button>
        <input type="hidden" name="size" value="@ViewBag.PageSize" />
    </form>
</div>
