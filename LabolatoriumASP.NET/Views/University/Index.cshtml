@model IEnumerable<University>

@{
    ViewBag.Title = "University List";
    Layout = "_Layout";
}

<h2>University List</h2>

<form method="get" class="d-flex mb-3 mt-3">
    <input type="text" name="search" class="form-control me-2"
           placeholder="Search universities" value="@ViewBag.SearchTerm" />
    <button type="submit" class="btn btn-primary d-flex me-1"> <i class="bi bi-search me-2"></i> Search </button>
    <a href="@Url.Action("Index", new { page = 1, size = ViewBag.PageSize })" class="btn btn-secondary">Clear</a>
</form>

<table class="table">
    <thead>
    <tr>
        <th>
            @Html.DisplayNameFor(u => u.UniversityName)
        </th>
        <th>
            @Html.DisplayNameFor(u => u.Country.CountryName)
        </th>
        <th>Ranking</th>
    </tr>
    </thead>
    <tbody>
    @if (Model.Any())
    {
        @foreach (var item in Model) {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.UniversityName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Country!.CountryName)
                </td>
                <td>
                    <a class="btn btn-outline-primary" asp-action="Details" asp-route-id="@item.Id">
                        <i class="bi bi-info-circle"></i> Details
                    </a>
                </td>
            </tr>
        }
    }
    else
    {
        <tr>
            <td colspan="3" class="text-center">No universities found.</td>
        </tr>
    }
    </tbody>
</table>

<div class="d-flex justify-content-between align-items-center mt-3">
    <div aria-label="Page navigation">
        <ul class="pagination">
            <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" 
                   asp-route-search="@ViewBag.SearchTerm" asp-route-page="@(ViewBag.CurrentPage - 1)">
                    <i class="bi bi-caret-left-fill"></i>
                </a>
            </li>

            @if (ViewBag.TotalPages > 1)
            {
                int startPage = Math.Max(1, ViewBag.CurrentPage - 2);
                int endPage = Math.Min(ViewBag.TotalPages, ViewBag.CurrentPage + 2);

                if (startPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="Index" asp-route-search="@ViewBag.SearchTerm" asp-route-page="1">1</a>
                    </li>
                    @if (startPage > 2)
                    {
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    }
                }

                for (int i = startPage; i <= endPage; i++)
                {
                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-search="@ViewBag.SearchTerm" asp-route-page="@i">@i</a>
                    </li>
                }

                if (endPage < ViewBag.TotalPages)
                {
                    @if (endPage < ViewBag.TotalPages - 1)
                    {
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    }
                    <li class="page-item">
                        <a class="page-link" asp-action="Index" asp-route-search="@ViewBag.SearchTerm" asp-route-page="@(ViewBag.TotalPages)">
                            @ViewBag.TotalPages
                        </a>
                    </li>
                }
            }

            <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" 
                   asp-route-search="@ViewBag.SearchTerm" asp-route-page="@(ViewBag.CurrentPage + 1)">
                    <i class="bi bi-caret-right-fill"></i>
                </a>
            </li>
        </ul>
    </div>

    <form method="get" class="d-flex align-items-center ms-3">
        <input type="hidden" name="search" value="@ViewBag.SearchTerm" />
        <input type="number" name="page" min="1" max="@ViewBag.TotalPages" class="form-control w-auto"
               placeholder="Page" value="@ViewBag.CurrentPage" />
        <button type="submit" class="btn btn-primary ms-2">
            Go
        </button>
        <input type="hidden" name="size" value="@ViewBag.PageSize" />
    </form>
</div>
