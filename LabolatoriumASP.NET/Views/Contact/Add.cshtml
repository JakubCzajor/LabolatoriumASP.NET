@model ContactModel

@{
    ViewBag.Title = "Add";
    Layout = "_Layout";
}

<h2>Dodaj kontakt</h2>
<div>
    <form asp-action="Add" method="post">
        <div class="mb-3">
            <label class="form-label" asp-for="FirstName"></label>
            <input class="form-control" type="text" asp-for="FirstName" />
            <span asp-validation-for="FirstName" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="LastName"></label>
            <input class="form-control" type="text" asp-for="LastName" />
            <span asp-validation-for="LastName" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="Email"></label>
            
            <input class="form-control" type="email" asp-for="Email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="PhoneNumber"></label>
            <input class="form-control" type="text" asp-for="PhoneNumber" />
            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="BirthDate"></label>
            <input class="form-control" type="date" asp-for="BirthDate" />
            <span asp-validation-for="BirthDate" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="Category"></label>
            <select class="form-control" asp-for="BirthDate" asp-items="@Html.GetEnumSelectList<Category>()"></select>
            <span asp-validation-for="Category" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="OrganizationId"></label>
            <select  asp-for="OrganizationId" asp-items="@Model.Organizations">
            </select>
            <span asp-validation-for="OrganizationId" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Dodaj</button>
    </form>
</div>