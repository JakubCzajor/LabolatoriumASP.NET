@model List<ContactModel>

@{
    ViewBag.Title = "Index";
    Layout = "_Layout";
}

<h2 class="mb-4">Kontakty</h2>
<a class="btn btn-primary" asp-action="Add" asp-controller="Contact">Dodaj kontakt</a>
@if (Model.Count > 0)
{
    <h4 class="mt-3 mb-1">Lista kontatków</h4>
    <table class="table">
        <thead>
        <tr>
            <th>@Html.DisplayNameFor(m => m[0].FirstName)</th>
            <th>@Html.DisplayNameFor(m => m[0].LastName)</th>
            <th>@Html.DisplayNameFor(m => m[0].Category)</th>
            <th>Akcje</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var entry in Model)
        {
            <tr>
                <td>@entry.FirstName</td>
                <td>@entry.LastName</td>
                <td>@entry.Category.GetDisplayName()</td>
                <td>
                    <div>
                        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@entry.Id">Edycja</a>
                        <a class="btn btn-secondary">Szczegóły</a>
                        <a class="btn btn-danger" asp-action="Delete" asp-route-id="@entry.Id">Usuń</a>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <h2 class="text-danger">Na razie brak kontaktów!</h2>
}